// RegGuard AI — Expanded Prisma Schema
// 29 state machines across 6 zones: Core, Surveillance, Quant, Intelligence, Collaboration, Platform
// SQLite-backed prototype; production should migrate to PostgreSQL+pgvector+Neo4j.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// CORE COMPLIANCE ZONE
// ─────────────────────────────────────────────────────────────

model Regulation {
  id            String   @id @default(cuid())
  title         String
  jurisdiction  String
  regulator     String
  category      String
  status        String
  effectiveDate DateTime
  summary       String
  impactLevel   String
  affectedUnits String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([jurisdiction])
  @@index([status])
  @@index([effectiveDate])
}

model Policy {
  id            String   @id @default(cuid())
  title         String
  category      String
  ownerUnit     String
  version       String
  status        String
  reviewDate    DateTime
  content       String
  aiSuggestion  String?
  lastUpdated   DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@index([category])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  actor       String
  action      String
  targetType  String
  targetId    String
  description String
  ipAddress   String?
  severity    String
  timestamp   DateTime @default(now())

  @@index([timestamp])
  @@index([action])
  @@index([targetType])
}

model RiskItem {
  id              String   @id @default(cuid())
  businessUnit    String
  regulationArea  String
  likelihood      Int
  impact          Int
  inherentRisk    Int
  residualRisk    Int
  trend           String
  owner           String
  mitigationPlan  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([businessUnit])
}

model ComplianceMetric {
  id              String   @id @default(cuid())
  snapshotDate    DateTime
  overallScore    Int
  openFindings    Int
  overdueTasks    Int
  policiesCurrent Int
  trainingComplete Int
  createdAt       DateTime @default(now())

  @@index([snapshotDate])
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  context   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// SURVEILLANCE ZONE
// ─────────────────────────────────────────────────────────────

/// Real-time transaction monitoring alerts (AML/CFT)
model SurveillanceAlert {
  id            String   @id @default(cuid())
  alertType     String   // structuring, layering, integration, smurfing, rapid_movement
  severity      String   // low, medium, high, critical
  accountId     String
  counterparty  String
  amount        Float
  currency      String
  jurisdiction  String
  channel       String   // SWIFT, SEPA, RTP, Wire, Crypto
  riskScore     Int      // 0-100
  status        String   // open, under_review, escalated, closed, false_positive
  triggeredRule String
  narrative     String
  timestamp     DateTime @default(now())

  @@index([severity])
  @@index([status])
  @@index([timestamp])
}

/// Sanctions screening hits
model SanctionsHit {
  id            String   @id @default(cuid())
  listName      String   // OFAC, UN, EU, HMT, MAS, OFSI
  matchType     String   // exact, fuzzy, partial, phonetic
  matchedName   String
  listedEntity  String
  entityId      String
  score         Int      // 0-100 confidence
  status        String   // pending, true_positive, false_positive, escalated
  reviewedBy    String?
  action        String?
  timestamp     DateTime @default(now())

  @@index([listName])
  @@index([status])
}

/// Communications surveillance events (voice/email/chat)
model CommsEvent {
  id           String   @id @default(cuid())
  channel      String   // email, voice, teams, bloomberg_chat, mobile
  participantA String
  participantB String
  desk         String   // Equities, FX, Rates, Credit, Macro
  signalType   String   // insider_trading, market_abuse, collusion, swearing, off_channel
  riskScore    Int
  transcript   String
  status       String
  timestamp    DateTime @default(now())

  @@index([signalType])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// QUANT & COMPUTATIONAL ZONE
// ─────────────────────────────────────────────────────────────

/// Quantitative risk scenarios (Monte Carlo, stress tests)
model QuantScenario {
  id            String   @id @default(cuid())
  scenarioType  String   // CCAR, EBA, BoE_ACS, FRTB_IMA, NGFS, custom
  description   String
  timeHorizon   String   // 1d, 1w, 1m, 1q, 1y
  p99Loss       Float
  expectedLoss  Float
  capitalImpact Float
  status        String   // draft, running, complete, archived
  createdAt     DateTime @default(now())

  @@index([scenarioType])
  @@index([status])
}

/// Climate & ESG risk metrics
model ClimateMetric {
  id                 String   @id @default(cuid())
  scope1Emissions    Float    // tCO2e
  scope2Emissions    Float
  scope3Emissions    Float
  financedEmissions  Float    // PCAF Methodology
  taxonomyAlignment  Float    // % EU Taxonomy aligned
  physicalRiskScore  Int      // 0-100
  transitionRiskScore Int
  reportingPeriod    String   // FY2024, H1_2025
  createdAt          DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// INTELLIGENCE & AUTOMATION ZONE
// ─────────────────────────────────────────────────────────────

/// Multi-agent orchestration runs
model AgentRun {
  id           String   @id @default(cuid())
  agentName    String   // regulatory_watcher, policy_drafter, control_tester, regulator_liaison
  task         String
  status       String   // queued, running, awaiting_approval, complete, failed
  inputs       String
  outputs      String
  toolsUsed    String
  approvedBy   String?
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  @@index([agentName])
  @@index([status])
}

/// Regulatory change feed (parsed new rules)
model RegulatoryChange {
  id            String   @id @default(cuid())
  source        String   // federal_register, ESMA, FCA, MAS, FSB
  title         String
  jurisdiction  String
  publishedAt   DateTime
  impactScore   Int      // 0-100
  affectedPolicies String
  status        String   // new, triaged, drafting, applied, dismissed
  summary       String
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([publishedAt])
}

/// Red team adversarial test results
model RedTeamTest {
  id           String   @id @default(cuid())
  testName     String
  attackVector String   // structuring, smurfing, sanctions_evasion, market_abuse, prompt_injection
  target       String
  result       String   // blocked, detected, bypassed
  severity     String
  evidence     String
  remediation  String?
  timestamp    DateTime @default(now())

  @@index([result])
  @@index([severity])
}

// ─────────────────────────────────────────────────────────────
// COLLABORATION & TRUST ZONE
// ─────────────────────────────────────────────────────────────

/// Case management for examinations & investigations
model ComplianceCase {
  id           String   @id @default(cuid())
  caseType     String   // examination, investigation, regulatory_request, internal_review
  title        String
  regulator    String?
  priority     String   // low, medium, high, critical
  status       String   // open, in_progress, awaiting_response, closed
  assignee     String
  dueDate      DateTime
  description  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// v3 (Task 13) — fields migrated from cases.json so the DB is the
  /// source of truth for the Case Management view. Previously these
  /// lived only in public/data/cases.json and were read from disk on
  /// every request.
  /// Number of evidence artifacts attached to the case.
  evidenceCount Int     @default(0)
  /// SLA tracking status — `on_track`, `at_risk`, `breach_imminent`, `breached`.
  slaStatus    String   @default("on_track")
  /// JSON blob of the AI recommendation — { action, confidence, reasoning, reviewerAction }.
  /// Stored as JSON string for SQLite; parse on read.
  aiRecommendationJson String?

  /// v3 (Task 13) — explicit case-citation links.
  /// Replaces the regulator/jurisdiction-inference retrieval path with
  /// a deterministic join: each case row has 0..N CaseCitation rows,
  /// each pointing at a KnowledgeChunk. Populated by the migration
  /// script (scripts/migrate-cases-to-db.ts) which runs retrieve() once
  /// per case and persists the top-K results as CaseCitation rows.
  citations    CaseCitation[]

  @@index([status])
  @@index([priority])
}

/// v3 (Task 13) — Explicit case-citation join table.
/// Replaces the implicit regulator/jurisdiction-inference retrieval
/// that the /api/cases/[id]/citations route used to do on every request.
///
/// Each row links one ComplianceCase to one KnowledgeChunk with a stored
/// relevance score (cosine similarity at the time of insertion) and an
/// optional `rank` to preserve retrieval ordering. The chunk snapshot
/// fields (title, snippet, sourceType, jurisdiction, category, pluginSlug)
/// are denormalised so the API can return Citation[] without a join back
/// to KnowledgeChunk — but the `chunkId` foreign key is preserved so
/// staleness can be detected (chunk deleted/updated since the link was
/// created).
model CaseCitation {
  id            String   @id @default(cuid())
  caseId        String
  chunkId       String
  /// Cosine similarity score at the time of insertion (0..1)
  relevanceScore Float
  /// 0-indexed retrieval rank (0 = most relevant)
  rank          Int
  /// Denormalised snapshot of the chunk at insertion time — lets the
  /// API return Citation[] without joining back to KnowledgeChunk.
  chunkTitle    String
  chunkSnippet  String
  chunkSourceType String
  chunkJurisdiction String?
  chunkCategory String?
  chunkPluginSlug String?
  createdAt     DateTime @default(now())

  case          ComplianceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([chunkId])
  @@index([rank])
}

/// Whistleblower intake reports
model WhistleblowerReport {
  id           String   @id @default(cuid())
  category     String   // fraud, market_abuse, harassment, safety, other
  severity     String
  description  String   // sanitized, PII-stripped
  anonymous    Boolean  @default(true)
  status       String   // received, triaged, investigating, resolved
  triageScore  Int?
  assignedTo   String?
  encryptedHash String
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([severity])
}

/// Blockchain-anchored audit evidence
model ChainAnchor {
  id            String   @id @default(cuid())
  payloadHash   String
  chain         String   // hyperledger_besu, ethereum_sepolia, polygon_amoy
  txHash        String
  blockNumber   Int
  anchorType    String   // audit_log, evidence, decision, attestation, merkle_root
  anchoredBy    String
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
  // ─── v2.2: Merkle tree + broadcast metadata ───
  verified      Boolean  @default(false)
  broadcastMode String?  // live_polygon_amoy, simulated_broadcast, merkle_proof_of_root
  merkleRoot    String?
  merkleProof   String?  // JSON-serialised array of {position, hash}
  leafCount     Int?
  chainId       Int?
  auditId       String?
  verificationUrl String?
  aiRecAction     String?
  aiRecConfidence Int?
  aiRecReasoning  String?

  @@index([chain])
  @@index([anchorType])
  @@index([verified])
}

// ─────────────────────────────────────────────────────────────────────
// v2.2 — SURVEILLANCE ZONE EXTENSIONS (Network Graph + Entity Enrichment)
// ─────────────────────────────────────────────────────────────────────

/// Entity-node in the network graph (counterparty, beneficial owner, account, address, wallet)
model NetworkEntity {
  id            String   @id @default(cuid())
  externalId    String   // n0, n1, ... — used by network.json edges
  label         String
  type          String   // person, company, account, address, crypto_wallet
  riskScore     Int      // 0-100
  jurisdiction  String
  isFlagged     Boolean  @default(false)
  // v2.2 enrichment
  enrichedName      String?
  enrichedSource    String?  // OFAC SDN, EU CFSP, OpenCorporates, GLEIF
  enrichedLei       String?
  enrichedAddress   String?
  enrichedVerifiedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([isFlagged])
  @@index([jurisdiction])
}

/// Relationship edge in the network graph (ownership, txn, shared_address, etc.)
model NetworkEdge {
  id        String   @id @default(cuid())
  source    String   // NetworkEntity.externalId
  target    String   // NetworkEntity.externalId
  type      String   // ownership, transaction, shared_address, beneficial_owner
  weight    Float
  currency  String
  timestamp DateTime @default(now())

  @@index([source])
  @@index([target])
  @@index([type])
}

/// Louvain community detection cluster result
model NetworkCluster {
  id        String   @id @default(cuid())
  clusterId String   // c0, c1, ...
  label     String
  risk      Int
  nodeCount Int
  detectedAt DateTime @default(now())

  @@index([clusterId])
}

// ─────────────────────────────────────────────────────────────────────
// v2.2 — PLATFORM ZONE EXTENSIONS (Time Machine)
// ─────────────────────────────────────────────────────────────────────

/// Counterfactual regulatory scenario (Time Machine view)
model CounterfactualScenario {
  id            String   @id @default(cuid())
  title         String
  description   String
  jurisdiction  String
  // Simulated baseline vs counterfactual outcomes
  baselineRiskScore    Int
  counterfactualRiskScore Int
  deltaPolicies  Int
  deltaCost      Float
  confidence     Int
  status         String   // draft, simulated, approved
  createdAt      DateTime @default(now())

  @@index([jurisdiction])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────
// v2.2 — QUANT ZONE EXTENSIONS (Systemic Risk)
// ─────────────────────────────────────────────────────────────────────

/// Systemic risk metric (D-SIB / G-SIB scorecard)
model SystemicRiskMetric {
  id              String   @id @default(cuid())
  bankName        String
