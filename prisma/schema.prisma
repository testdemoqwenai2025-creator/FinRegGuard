// RegGuard AI — Expanded Prisma Schema
// 29 state machines across 6 zones: Core, Surveillance, Quant, Intelligence, Collaboration, Platform
// SQLite-backed prototype; production should migrate to PostgreSQL+pgvector+Neo4j.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// CORE COMPLIANCE ZONE
// ─────────────────────────────────────────────────────────────

model Regulation {
  id            String   @id @default(cuid())
  title         String
  jurisdiction  String
  regulator     String
  category      String
  status        String
  effectiveDate DateTime
  summary       String
  impactLevel   String
  affectedUnits String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([jurisdiction])
  @@index([status])
  @@index([effectiveDate])
}

model Policy {
  id            String   @id @default(cuid())
  title         String
  category      String
  ownerUnit     String
  version       String
  status        String
  reviewDate    DateTime
  content       String
  aiSuggestion  String?
  lastUpdated   DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@index([category])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  actor       String
  action      String
  targetType  String
  targetId    String
  description String
  ipAddress   String?
  severity    String
  timestamp   DateTime @default(now())

  @@index([timestamp])
  @@index([action])
  @@index([targetType])
}

model RiskItem {
  id              String   @id @default(cuid())
  businessUnit    String
  regulationArea  String
  likelihood      Int
  impact          Int
  inherentRisk    Int
  residualRisk    Int
  trend           String
  owner           String
  mitigationPlan  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([businessUnit])
}

model ComplianceMetric {
  id              String   @id @default(cuid())
  snapshotDate    DateTime
  overallScore    Int
  openFindings    Int
  overdueTasks    Int
  policiesCurrent Int
  trainingComplete Int
  createdAt       DateTime @default(now())

  @@index([snapshotDate])
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  context   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// SURVEILLANCE ZONE
// ─────────────────────────────────────────────────────────────

/// Real-time transaction monitoring alerts (AML/CFT)
model SurveillanceAlert {
  id            String   @id @default(cuid())
  alertType     String   // structuring, layering, integration, smurfing, rapid_movement
  severity      String   // low, medium, high, critical
  accountId     String
  counterparty  String
  amount        Float
  currency      String
  jurisdiction  String
  channel       String   // SWIFT, SEPA, RTP, Wire, Crypto
  riskScore     Int      // 0-100
  status        String   // open, under_review, escalated, closed, false_positive
  triggeredRule String
  narrative     String
  timestamp     DateTime @default(now())

  @@index([severity])
  @@index([status])
  @@index([timestamp])
}

/// Sanctions screening hits
model SanctionsHit {
  id            String   @id @default(cuid())
  listName      String   // OFAC, UN, EU, HMT, MAS, OFSI
  matchType     String   // exact, fuzzy, partial, phonetic
  matchedName   String
  listedEntity  String
  entityId      String
  score         Int      // 0-100 confidence
  status        String   // pending, true_positive, false_positive, escalated
  reviewedBy    String?
  action        String?
  timestamp     DateTime @default(now())

  @@index([listName])
  @@index([status])
}

/// Communications surveillance events (voice/email/chat)
model CommsEvent {
  id           String   @id @default(cuid())
  channel      String   // email, voice, teams, bloomberg_chat, mobile
  participantA String
  participantB String
  desk         String   // Equities, FX, Rates, Credit, Macro
  signalType   String   // insider_trading, market_abuse, collusion, swearing, off_channel
  riskScore    Int
  transcript   String
  status       String
  timestamp    DateTime @default(now())

  @@index([signalType])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// QUANT & COMPUTATIONAL ZONE
// ─────────────────────────────────────────────────────────────

/// Quantitative risk scenarios (Monte Carlo, stress tests)
model QuantScenario {
  id            String   @id @default(cuid())
  scenarioType  String   // CCAR, EBA, BoE_ACS, FRTB_IMA, NGFS, custom
  description   String
  timeHorizon   String   // 1d, 1w, 1m, 1q, 1y
  p99Loss       Float
  expectedLoss  Float
  capitalImpact Float
  status        String   // draft, running, complete, archived
  createdAt     DateTime @default(now())

  @@index([scenarioType])
  @@index([status])
}

/// Climate & ESG risk metrics
model ClimateMetric {
  id                 String   @id @default(cuid())
  scope1Emissions    Float    // tCO2e
  scope2Emissions    Float
  scope3Emissions    Float
  financedEmissions  Float    // PCAF Methodology
  taxonomyAlignment  Float    // % EU Taxonomy aligned
  physicalRiskScore  Int      // 0-100
  transitionRiskScore Int
  reportingPeriod    String   // FY2024, H1_2025
  createdAt          DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// INTELLIGENCE & AUTOMATION ZONE
// ─────────────────────────────────────────────────────────────

/// Multi-agent orchestration runs
model AgentRun {
  id           String   @id @default(cuid())
  agentName    String   // regulatory_watcher, policy_drafter, control_tester, regulator_liaison
  task         String
  status       String   // queued, running, awaiting_approval, complete, failed
  inputs       String
  outputs      String
  toolsUsed    String
  approvedBy   String?
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  @@index([agentName])
  @@index([status])
}

/// Regulatory change feed (parsed new rules)
model RegulatoryChange {
  id            String   @id @default(cuid())
  source        String   // federal_register, ESMA, FCA, MAS, FSB
  title         String
  jurisdiction  String
  publishedAt   DateTime
  impactScore   Int      // 0-100
  affectedPolicies String
  status        String   // new, triaged, drafting, applied, dismissed
  summary       String
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([publishedAt])
}

/// Red team adversarial test results
model RedTeamTest {
  id           String   @id @default(cuid())
  testName     String
  attackVector String   // structuring, smurfing, sanctions_evasion, market_abuse, prompt_injection
  target       String
  result       String   // blocked, detected, bypassed
  severity     String
  evidence     String
  remediation  String?
  timestamp    DateTime @default(now())

  @@index([result])
  @@index([severity])
}

// ─────────────────────────────────────────────────────────────
// COLLABORATION & TRUST ZONE
// ─────────────────────────────────────────────────────────────

/// Case management for examinations & investigations
model ComplianceCase {
  id           String   @id @default(cuid())
  caseType     String   // examination, investigation, regulatory_request, internal_review
  title        String
  regulator    String?
  priority     String   // low, medium, high, critical
  status       String   // open, in_progress, awaiting_response, closed
  assignee     String
  dueDate      DateTime
  description  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// v3 (Task 13) — fields migrated from cases.json so the DB is the
  /// source of truth for the Case Management view. Previously these
  /// lived only in public/data/cases.json and were read from disk on
  /// every request.
  /// Number of evidence artifacts attached to the case.
  evidenceCount Int     @default(0)
  /// SLA tracking status — `on_track`, `at_risk`, `breach_imminent`, `breached`.
  slaStatus    String   @default("on_track")
  /// JSON blob of the AI recommendation — { action, confidence, reasoning, reviewerAction }.
  /// Stored as JSON string for SQLite; parse on read.
  aiRecommendationJson String?

  /// v3 (Task 13) — explicit case-citation links.
  /// Replaces the regulator/jurisdiction-inference retrieval path with
  /// a deterministic join: each case row has 0..N CaseCitation rows,
  /// each pointing at a KnowledgeChunk. Populated by the migration
  /// script (scripts/migrate-cases-to-db.ts) which runs retrieve() once
  /// per case and persists the top-K results as CaseCitation rows.
  citations    CaseCitation[]

  @@index([status])
  @@index([priority])
}

/// v3 (Task 13) — Explicit case-citation join table.
/// Replaces the implicit regulator/jurisdiction-inference retrieval
/// that the /api/cases/[id]/citations route used to do on every request.
///
/// Each row links one ComplianceCase to one KnowledgeChunk with a stored
/// relevance score (cosine similarity at the time of insertion) and an
/// optional `rank` to preserve retrieval ordering. The chunk snapshot
/// fields (title, snippet, sourceType, jurisdiction, category, pluginSlug)
/// are denormalised so the API can return Citation[] without a join back
/// to KnowledgeChunk — but the `chunkId` foreign key is preserved so
/// staleness can be detected (chunk deleted/updated since the link was
/// created).
model CaseCitation {
  id            String   @id @default(cuid())
  caseId        String
  chunkId       String
  /// Cosine similarity score at the time of insertion (0..1)
  relevanceScore Float
  /// 0-indexed retrieval rank (0 = most relevant)
  rank          Int
  /// Denormalised snapshot of the chunk at insertion time — lets the
  /// API return Citation[] without joining back to KnowledgeChunk.
  chunkTitle    String
  chunkSnippet  String
  chunkSourceType String
  chunkJurisdiction String?
  chunkCategory String?
  chunkPluginSlug String?
  createdAt     DateTime @default(now())

  case          ComplianceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([chunkId])
  @@index([rank])
}

/// Whistleblower intake reports
model WhistleblowerReport {
  id           String   @id @default(cuid())
  category     String   // fraud, market_abuse, harassment, safety, other
  severity     String
  description  String   // sanitized, PII-stripped
  anonymous    Boolean  @default(true)
  status       String   // received, triaged, investigating, resolved
  triageScore  Int?
  assignedTo   String?
  encryptedHash String
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([severity])
}

/// Blockchain-anchored audit evidence
model ChainAnchor {
  id            String   @id @default(cuid())
  payloadHash   String
  chain         String   // hyperledger_besu, ethereum_sepolia, polygon_amoy
  txHash        String
  blockNumber   Int
  anchorType    String   // audit_log, evidence, decision, attestation, merkle_root
  anchoredBy    String
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
  // ─── v2.2: Merkle tree + broadcast metadata ───
  verified      Boolean  @default(false)
  broadcastMode String?  // live_polygon_amoy, simulated_broadcast, merkle_proof_of_root
  merkleRoot    String?
  merkleProof   String?  // JSON-serialised array of {position, hash}
  leafCount     Int?
  chainId       Int?
  auditId       String?
  verificationUrl String?
  aiRecAction     String?
  aiRecConfidence Int?
  aiRecReasoning  String?

  @@index([chain])
  @@index([anchorType])
  @@index([verified])
}

// ─────────────────────────────────────────────────────────────────────
// v2.2 — SURVEILLANCE ZONE EXTENSIONS (Network Graph + Entity Enrichment)
// ─────────────────────────────────────────────────────────────────────

/// Entity-node in the network graph (counterparty, beneficial owner, account, address, wallet)
model NetworkEntity {
  id            String   @id @default(cuid())
  externalId    String   // n0, n1, ... — used by network.json edges
  label         String
  type          String   // person, company, account, address, crypto_wallet
  riskScore     Int      // 0-100
  jurisdiction  String
  isFlagged     Boolean  @default(false)
  // v2.2 enrichment
  enrichedName      String?
  enrichedSource    String?  // OFAC SDN, EU CFSP, OpenCorporates, GLEIF
  enrichedLei       String?
  enrichedAddress   String?
  enrichedVerifiedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([isFlagged])
  @@index([jurisdiction])
}

/// Relationship edge in the network graph (ownership, txn, shared_address, etc.)
model NetworkEdge {
  id        String   @id @default(cuid())
  source    String   // NetworkEntity.externalId
  target    String   // NetworkEntity.externalId
  type      String   // ownership, transaction, shared_address, beneficial_owner
  weight    Float
  currency  String
  timestamp DateTime @default(now())

  @@index([source])
  @@index([target])
  @@index([type])
}

/// Louvain community detection cluster result
model NetworkCluster {
  id        String   @id @default(cuid())
  clusterId String   // c0, c1, ...
  label     String
  risk      Int
  nodeCount Int
  detectedAt DateTime @default(now())

  @@index([clusterId])
}

// ─────────────────────────────────────────────────────────────────────
// v2.2 — PLATFORM ZONE EXTENSIONS (Time Machine)
// ─────────────────────────────────────────────────────────────────────

/// Counterfactual regulatory scenario (Time Machine view)
model CounterfactualScenario {
  id            String   @id @default(cuid())
  title         String
  description   String
  jurisdiction  String
  // Simulated baseline vs counterfactual outcomes
  baselineRiskScore    Int
  counterfactualRiskScore Int
  deltaPolicies  Int
  deltaCost      Float
  confidence     Int
  status         String   // draft, simulated, approved
  createdAt      DateTime @default(now())

  @@index([jurisdiction])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────
// v2.2 — QUANT ZONE EXTENSIONS (Systemic Risk)
// ─────────────────────────────────────────────────────────────────────

/// Systemic risk metric (D-SIB / G-SIB scorecard)
model SystemicRiskMetric {
  id              String   @id @default(cuid())
  bankName        String
  bucket          String   // D-SIB bucket 1-5
  // Basel indicator metrics
  size            Float
  interconnectedness Float
  substitutability Float
  complexity      Float
  crossJurisdiction Float
  // Aggregate
  systemicScore   Int
  trend           String   // increasing, stable, decreasing
  lastRefreshed   DateTime @default(now())

  @@index([bankName])
  @@index([bucket])
}

// ─────────────────────────────────────────────────────────────────────
// v2.2 — COLLABORATION ZONE EXTENSIONS (Regulator Portal)
// ─────────────────────────────────────────────────────────────────────

/// Submission to regulator portal (exam pack, SAR, RFI response)
model RegulatorSubmission {
  id           String   @id @default(cuid())
  regulator    String   // FCA, SEC, ESMA, MAS, PRA, FinCEN
  submissionType String // exam_pack, SAR, RFI_response, quarterly_return
  status       String   // draft, in_review, submitted, accepted, rejected
  dueDate      DateTime?
  submittedAt  DateTime?
  submittedBy  String?
  contentHash  String?  // SHA-256 of submission contents
  chainAnchorId String? // FK to ChainAnchor if anchored on-chain
  createdAt    DateTime @default(now())

  @@index([regulator])
  @@index([status])
  @@index([submissionType])
}

/// Digital asset compliance events
model DigitalAssetEvent {
  id           String   @id @default(cuid())
  asset        String   // BTC, ETH, USDT, CBDC
  wallet       String
  counterparty String
  amount       Float
  eventType    String   // travel_rule, sanctions_screen, mixer_detection, ofac_match
  riskScore    Int
  status       String
  chain        String
  timestamp    DateTime @default(now())

  @@index([eventType])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// PLATFORM & GOVERNANCE ZONE
// ─────────────────────────────────────────────────────────────

/// Privacy-enhancing technology configurations
model PetConfig {
  id           String   @id @default(cuid())
  dataset      String
  technique    String   // federated_learning, homomorphic_encryption, differential_privacy, secure_enclave
  enabled      Boolean  @default(false)
  parameters   String
  approvedBy   String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([technique])
}

/// API keys & webhook configs for Developer Hub
model ApiKey {
  id           String   @id @default(cuid())
  name         String
  keyPrefix    String
  scopes       String
  rateLimit    Int
  status       String   // active, revoked, expired
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([status])
}

/// Cross-jurisdictional rule comparison (Harmonizer)
model RuleComparison {
  id           String   @id @default(cuid())
  topic        String   // e.g., "derivatives_reporting"
  jurisdictions String  // e.g., "US,EU,UK"
  differences  String
  harmonizationPath String?
  createdAt    DateTime @default(now())

  @@index([topic])
}

/// Explainable Compliance Cards (per-decision audit)
model ComplianceCard {
  id           String   @id @default(cuid())
  decisionId   String
  decision     String   // approved, flagged, declined
  regulation   String
  policyRef    String
  evidence     String
  reasoning    String
  confidence   Int      // 0-100
  generatedAt  DateTime @default(now())

  @@index([decision])
}

// ─────────────────────────────────────────────────────────────
// AI INTELLIGENCE LAYER (Pillar 1) — Vector Store + RAG
// ─────────────────────────────────────────────────────────────
// Stores chunked regulatory/policy text + sparse TF-IDF vectors
// as JSON (SQLite has no native vector type). Cosine similarity
// is computed in JS at query time — fine for ~10k chunks.
// Migration path to pgvector / Qdrant is provider-pluggable.

/// A chunk of text from a regulation, policy, risk item, or external source
/// that has been indexed into the vector store for RAG retrieval.
model KnowledgeChunk {
  id            String   @id @default(cuid())
  sourceType    String   // regulation | policy | risk | audit | external | guidance
  sourceId      String   // ID of the originating record (e.g. Regulation.id)
  title         String   // Display title (e.g. "EU AI Act — Art. 6(2) High-Risk")
  content       String   // The chunk text (typically 200-500 chars)
  jurisdiction  String?  // e.g. "EU", "US", "UK", "Global"
  category      String?  // e.g. "ai-governance", "aml", "privacy"
  /// Sparse TF-IDF vector stored as JSON: { "term1": weight1, "term2": weight2, ... }
  /// Computed by the active EmbeddingProvider. For sparse vectors, only non-zero
  /// terms are stored. For dense vectors (future neural embeddings), the full
  /// array is stored and `vectorType` is set to "dense".
  vector        String   // JSON-serialised sparse vector map
  vectorType    String   @default("sparse-tfidf")  // sparse-tfidf | dense-minilm | dense-openai
  /// L2 norm of the vector — precomputed for fast cosine similarity
  norm          Float    @default(0)
  /// Number of tokens in the chunk (for BM25 length normalisation if needed)
  tokenCount    Int      @default(0)
  /// Free-form metadata blob (e.g. article number, effective date, source URL)
  metadata      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sourceType])
  @@index([sourceId])
  @@index([jurisdiction])
  @@index([category])
}

/// Corpus-level statistics for TF-IDF computation.
/// Singleton row (id = "corpus") — updated whenever chunks are upserted.
model CorpusStats {
  id            String   @id @default("corpus")
  /// Total number of indexed chunks (N in IDF formula)
  documentCount Int      @default(0)
  /// Document frequency per term: { "term": doc_count, ... }
  /// Used to compute IDF = log(N / (1 + df))
  docFrequencies String  @default("{}")  // JSON map
  /// Average chunk length in tokens (for BM25 normalisation)
  avgDocLength  Float    @default(0)
  updatedAt     DateTime @updatedAt
}

/// Conversation sessions for the AI Copilot — supports multi-turn context
/// with retrieval history. Each session tracks the messages + the chunks
/// that were retrieved for each assistant turn (for source citations).
model ChatSession {
  id        String   @id @default(cuid())
  title     String?  // Optional human-readable title (auto-derived from first message)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  ChatMessageV2[]
}

/// V2 chat messages — linked to a session, with retrieval provenance.
/// Replaces the flat ChatMessage model for new conversations.
model ChatMessageV2 {
  id         String   @id @default(cuid())
  sessionId  String
  role       String   // user | assistant | system
  content    String
  /// JSON array of KnowledgeChunk IDs retrieved for this turn
  /// (only populated for assistant messages)
  sourceChunkIds String?
  /// Latency in ms for the LLM call (assistant messages only)
  latencyMs  Int?
  createdAt  DateTime @default(now())

  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([role])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// PLUGIN REGISTRY — DeepSeek-style enable/disable system for
// regulatory forms, labels, features, and document templates.
// Plugins can be loaded from web sources and auto-filled with
// templates from authoritative regulators (SEC, FINRA, ESMA, etc.)
// ─────────────────────────────────────────────────────────────

/// A registry plugin — represents a regulation form, label,
/// feature flag, or document template that can be toggled on/off.
/// When enabled, the plugin's data is exposed to dependent views.
/// When marked isDefault, the plugin is the primary source for
/// its category/jurisdiction pair.
model Plugin {
  id            String   @id @default(cuid())
  /// Stable slug — e.g. "sec-form-adv", "label-high-risk", "feature-sanctions-live"
  slug          String   @unique
  name          String
  description   String
  /// form | label | feature | document
  category      String
  /// US | EU | UK | SG | HK | JP | CA | AU | GLOBAL
  jurisdiction  String
  /// SEC | FINRA | ESMA | FCA | MAS | SFC | FSA | OFAC | INTERNAL
  regulator     String?
  version       String   @default("1.0.0")
  /// Source URL where the canonical template lives (regulator website, GitHub, etc.)
  sourceUrl     String
  /// web | template | api | github | rss
  sourceType    String   @default("web")
  /// JSON schema describing the form/label/feature/document fields
  /// Used by the auto-fill engine to render preview + collect values
  schemaJson    String?
  /// Default field values used to auto-fill on first enable
  defaultFieldsJson String?
  /// Tags for filtering in the Plugin Manager UI
  tagsJson      String   @default("[]")
  enabled       Boolean  @default(false)
  isDefault     Boolean  @default(false)
  /// When was this plugin last refreshed from sourceUrl
  lastRefreshedAt DateTime?
  /// When was this plugin first enabled
  enabledAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  template      PluginTemplate?
  history       PluginToggleHistory[]

  @@index([category])
  @@index([jurisdiction])
  @@index([enabled])
  @@index([isDefault])
}

/// Cached template content fetched from sourceUrl.
/// Avoids re-fetching on every page load; refreshed explicitly
/// via the Plugin Manager UI or via scheduled refresh.
model PluginTemplate {
  id            String   @id @default(cuid())
  pluginId      String   @unique
  /// Raw content fetched from sourceUrl (HTML, JSON, MD, XML, etc.)
  rawContent    String
  /// Content-Type header from the source response
  contentType   String?
  /// SHA-256 hash of rawContent — used to detect drift between
  /// the cached template and the live source
  contentHash   String
  /// HTTP status of the last fetch (200, 404, 403, etc.)
  fetchStatus   Int      @default(200)
  /// Optional error message if the fetch failed
  fetchError    String?
  /// Parsed/normalized fields extracted from rawContent
  /// (e.g., for SEC Form ADV: { firm_name: "", crd_number: "", ... })
  parsedFieldsJson String?
  fetchedAt     DateTime @default(now())

  plugin        Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@index([fetchedAt])
}

/// Audit trail of every enable/disable/set-default action —
/// supports the "machine proposes, human confirms" governance model.
model PluginToggleHistory {
  id            String   @id @default(cuid())
  pluginId      String
  /// enabled | disabled | set_default | unset_default | refreshed | autofilled
  /// Drift scanner also writes: drift_reindex | drift_no_change | drift_failed
  action        String
  /// Who triggered the action (user email, "system", or "auto-refresh")
  actor         String   @default("system")
  /// Optional notes — e.g., "User auto-filled from SEC.gov template"
  notes         String?
  createdAt     DateTime @default(now())
  /// Set when a user dismisses the event from the DriftBell UI.
  /// Null = unacknowledged (still surfaces in the bell badge count).
  acknowledgedAt DateTime?
  /// Who dismissed the event (typically "user"). Null when unacknowledged.
  acknowledgedBy String?

  plugin        Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@index([pluginId])
  @@index([action])
  @@index([createdAt])
  @@index([acknowledgedAt])
}

// ─────────────────────────────────────────────────────────────
// FORM AUTO-FILL STACK (Phase 1 — Commit 1)
//
// Recruitment-ATS-style auto-population of regulatory forms from
// live web connectors. Every field value carries provenance: which
// connector, what timestamp, what raw payload hash, what parser
// version, what confidence score.
//
// 7-layer stack:
//   L1  Connector registry + engine (polls live feeds)
//   L2  Parsers (per-response-format → canonical JSON)
//   L3  Field ontology (field_name → source connector + fallback chain)
//   L4  Form template registry (per-form field schemas)
//   L5  Auto-fill orchestrator (form_slug + entity_id → filled form)
//   L6  Audit trail (FormFieldProvenance per field write)
//   L7  Human review queue (low-confidence fields routed to reviewer)
// ─────────────────────────────────────────────────────────────

/// L1 — Connector registry. Each row represents a live external
/// data feed (LEI, Companies House, EDGAR, OFAC, OpenCorporates,
/// ESMA, FCA, MAS, chainalysis, etc.). The ConnectorEngine polls
/// each feed on a schedule and writes ConnectorRun records.
model Connector {
  id              String   @id @default(cuid())
  /// Stable slug — e.g. "lei", "companies_house", "edgar", "ofac", "opencorporates"
  slug            String   @unique
  name            String
  /// live_feed | registry | sanctions_list | filings_index | corporate_registry
  kind            String   @default("registry")
  /// Base endpoint URL (auth + query params appended by connector impl)
  endpoint        String
  /// none | api_key_header | api_key_query | oauth2_client_credentials | basic
  authScheme      String   @default("none")
  /// Encrypted JSON: { api_key_env, client_id_env, client_secret_env, token_url, scope }
  /// Secrets are read from process.env at runtime — never stored in the DB.
  authConfigJson  String   @default("{}")
  /// Requests per minute (0 = unlimited)
  rateLimitPerMin Int      @default(60)
  /// closed | open | half_open
  circuitBreakerState String @default("closed")
  /// When the circuit last opened (for the 15-min cooldown)
  circuitOpenedAt DateTime?
  lastPollAt      DateTime?
  lastSuccessAt   DateTime?
  /// Rolling 24h error count — used by the UI to flag unhealthy feeds
  errorCount24h   Int      @default(0)
  /// Records successfully pulled across all time (lifetime counter)
  recordsPulledLifetime Int @default(0)
  /// Average response latency in ms (EWMA updated on each poll)
  avgLatencyMs    Int      @default(0)
  /// Is the connector enabled for the auto-fill orchestrator?
  enabled         Boolean  @default(true)
  /// Markdown description of what this connector provides
  description     String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  runs            ConnectorRun[]
  fieldOntologies FieldOntology[]
  fieldValueSources FormFieldValue[]

  @@index([slug])
  @@index([enabled])
  @@index([circuitBreakerState])
}

/// L1 — One poll attempt against a connector. Records the raw payload
/// hash so reviewers can trace any field value back to the exact API
/// response that populated it. Used by the regulator examination PDF.
model ConnectorRun {
  id              String   @id @default(cuid())
  connectorId     String
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  /// success | partial | failure | circuit_open
  status          String   @default("running")
  /// HTTP status code (or 0 if request never completed)
  httpStatus      Int      @default(0)
  /// Number of records parsed from the response
  recordsPulled   Int      @default(0)
  /// SHA-256 hash of the raw response body — links FormFieldProvenance
  rawPayloadHash  String?
  /// First 500 chars of the response (for quick inspection in UI)
  payloadSnippet  String?
  /// Error message if status != success
  errorMessage    String?
  /// Endpoint actually called (with query params, secrets redacted)
  endpointCalled  String?
  /// Latency in ms (finishedAt - startedAt)
  latencyMs       Int      @default(0)

  connector       Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId])
  @@index([startedAt])
  @@index([status])
  @@index([rawPayloadHash])
}

/// L3 — Field ontology. Maps a canonical field name (e.g.,
/// "beneficial_owners[].nationality") to the connector that is the
/// source of truth for that field, the parser to use, and a fallback
/// chain of alternative connectors if the primary source is unavailable
/// or returns no data for the given entity.
///
/// `sourceOfTruthByJurisdiction` is a JSON map like:
///   { "UK": "companies_house", "EU": "lei", "US": "edgar", "_default": "opencorporates" }
///
/// This allows the auto-fill orchestrator to pick the right connector
/// based on the entity's jurisdiction.
model FieldOntology {
  id              String   @id @default(cuid())
  /// Canonical field path — e.g. "legal_name", "beneficial_owners[].nationality",
  /// "sanctions_screening_result", "source_of_funds_evidence"
  fieldName       String   @unique
  /// string | date | country_code_iso3166 | integer | decimal | boolean | json_array | json_object
  canonicalType   String   @default("string")
  /// Human-readable description of what this field represents
  description     String   @default("")
  /// JSON map: jurisdiction → connector slug (e.g., {"UK":"companies_house","_default":"opencorporates"})
  sourceOfTruthByJurisdiction String @default("{}")
  /// Parser slug — e.g. "companies_house_officers_json", "ofac_sd_xml", "lei_search_json"
  parserSlug      String
  /// JSON array of connector slugs tried in order if primary returns no data
  /// e.g. ["lei", "opencorporates"]
  fallbackChainJson String  @default("[]")
  /// Minimum confidence threshold below which the field is routed to the review queue
  /// high (0.9) | medium (0.7) | low (0.5)
  confidenceThreshold String @default("medium")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// The primary connector (resolved from sourceOfTruthByJurisdiction._default)
  /// — kept as a relation for convenience joins. For jurisdiction-specific
  /// sources, the orchestrator looks up sourceOfTruthByJurisdiction at runtime.
  primaryConnector Connector? @relation(fields: [primaryConnectorId], references: [id])
  primaryConnectorId String?

  @@index([fieldName])
  @@index([parserSlug])
}

/// L4 — Form template registry. Each row is a fillable form schema
/// (EDD, SAR, MiCA CASP application, Travel Rule message, etc.).
/// The fieldSchemaJson describes every field: name, type, required,
/// validation rules, and the autofill_strategy (which FieldOntology
/// field to populate from).
///
/// Example fieldSchemaJson:
///   {
///     "fields": [
///       { "name": "legal_name", "type": "string", "required": true,
///         "autofill_field": "legal_name" },
///       { "name": "beneficial_owners", "type": "json_array", "required": true,
///         "autofill_field": "beneficial_owners" },
///       { "name": "sanctions_screening_result", "type": "json_object", "required": true,
///         "autofill_field": "sanctions_screening_result" }
///     ]
///   }
model FormTemplate {
  id              String   @id @default(cuid())
  /// Stable slug matching the plugin catalog — e.g. "edd-form-framework",
  /// "sar-next-gen-template", "form-mica-casp"
  slug            String   @unique
  name            String
  /// JSON Schema describing the form's fields (see example above)
  fieldSchemaJson String
  /// EDD | SAR | MiCA_CASP | Travel_Rule | Climate_Scenario | GDPR_RoPA | custom
  formType        String   @default("custom")
  regulator       String   @default("INTERNAL")
  jurisdiction    String   @default("GLOBAL")
  /// Template version (semver) — bumped when field schema changes
  version         String   @default("1.0.0")
  /// Markdown description of the form's purpose and required evidence
  description     String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  instances       FormInstance[]

  @@index([slug])
  @@index([formType])
  @@index([jurisdiction])
}

/// L5 — A filled (or partially filled) form instance. Created when
/// a user opens a form template and triggers auto-fill. Each instance
/// is tied to a specific entity (counterparty, customer, transaction).
model FormInstance {
  id              String   @id @default(cuid())
  templateId      String
  /// External entity identifier — e.g. "LEI:529900T8BM49AURQ",
  /// "CRN:12345678", "TXN:0xabc123..."
  entityId        String
  /// Entity type — counterparty | customer | transaction | beneficial_owner
  entityType      String   @default("counterparty")
  /// Entity display name (denormalized for UI)
  entityName      String   @default("")
  /// draft | auto_filling | in_review | submitted | withdrawn | rejected
  status          String   @default("draft")
  /// Overall confidence score for the auto-filled form (0.0–1.0)
  /// Computed as the weighted mean of FormFieldValue.confidence
  overallConfidence Float  @default(0)
  /// Number of fields that were auto-filled (vs. manually entered)
  autoFilledFieldCount Int @default(0)
  /// Number of fields routed to the review queue (low confidence)
  reviewQueueCount Int     @default(0)
  /// Who created the form instance (user email or "system")
  createdBy       String   @default("system")
  /// When the form was submitted (null until status=submitted)
  submittedAt     DateTime?
  /// Who submitted the form (reviewer email)
  submittedBy     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  template        FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldValues     FormFieldValue[]
  reviewQueueItems ReviewQueueItem[]

  @@index([templateId])
  @@index([entityId])
  @@index([status])
  @@index([createdAt])
}

/// L5 — A single field value in a form instance. Each value carries
/// a confidence score (0.0–1.0) and a reference to the connector that
/// populated it. If the field was manually entered by a reviewer,
/// sourceConnectorId is null and sourceConnectorName is "manual".
model FormFieldValue {
  id              String   @id @default(cuid())
  instanceId      String
  /// Dotted field path matching FormTemplate.fieldSchemaJson — e.g.
  /// "legal_name", "beneficial_owners[0].nationality", "sanctions_screening_result"
  fieldPath       String
  /// JSON-encoded value (string, number, array, object — depends on field type)
  valueJson       String
  /// Confidence score (0.0–1.0). high >= 0.9, medium >= 0.7, low < 0.7
  confidence      Float    @default(0)
  /// high | medium | low — derived from confidence
  confidenceBand  String   @default("low")
  /// Was this value auto-filled (true) or manually entered (false)?
  autoFilled      Boolean  @default(true)
  /// Field-ontology entry that resolved this field (null if manual)
  ontologyFieldName String?

  sourceConnector   Connector? @relation(fields: [sourceConnectorId], references: [id])
  sourceConnectorId String?

  provenance      FormFieldProvenance?
  reviewQueueItem ReviewQueueItem?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  instance        FormInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([fieldPath])
  @@index([confidenceBand])
  @@index([autoFilled])
  @@index([sourceConnectorId])
}

/// L6 — Provenance record for a single field write. Captures the
/// exact API response that populated the field: which connector run,
/// what timestamp, what raw payload hash, what parser version, what
/// payload snippet. This is the artifact a regulator examiner wants
/// to see — every field traceable to its source.
model FormFieldProvenance {
  id              String   @id @default(cuid())
  fieldValueId    String   @unique
  /// The ConnectorRun that produced the raw payload for this field
  connectorRunId  String?
  /// Connector slug (denormalized for fast queries without joins)
  connectorSlug   String
  /// When the connector was called
  fetchedAt       DateTime @default(now())
  /// SHA-256 hash of the raw response body — links to ConnectorRun.rawPayloadHash
  rawPayloadHash  String?
  /// Parser slug — e.g. "companies_house_officers_json"
  parserSlug      String
  /// Parser version (semver) — so we can re-parse old payloads if parser logic changes
  parserVersion   String   @default("1.0.0")
  /// First 500 chars of the raw payload (for the side-by-side reviewer UI)
  payloadSnippet  String?
  /// The exact JSON path within the raw payload that yielded this value
  /// e.g. "/items/0/address/country"
  payloadJsonPath String?
  /// Confidence at the moment of capture (may differ from current
  /// FormFieldValue.confidence if the reviewer later edited the value)
  confidenceAtCapture Float @default(0)
  createdAt       DateTime @default(now())

  fieldValue      FormFieldValue @relation(fields: [fieldValueId], references: [id], onDelete: Cascade)

  @@index([fieldValueId])
  @@index([connectorSlug])
  @@index([fetchedAt])
  @@index([rawPayloadHash])
}

/// L7 — Human review queue. Auto-fill routes low-confidence field
/// values here for reviewer sign-off. Reviewer sees the field value
/// side-by-side with the raw connector payload, then approves / edits
/// / rejects. Every action is audit-logged.
model ReviewQueueItem {
  id              String   @id @default(cuid())
  /// The form field value that needs review
  fieldValueId    String   @unique
  /// The form instance (denormalized for fast "open items by form" queries)
  instanceId      String
  /// pending | assigned | approved | edited | rejected | escalated
  status          String   @default("pending")
  /// Why was this routed to review? (low_confidence | no_data | conflict |
  /// sanctions_hit | manual_flag)
  reason          String   @default("low_confidence")
  /// Reviewer assigned (email). Null until an reviewer picks up the item.
  reviewerId      String?
  /// Team the item is routed to — KYC | MLRO | Licensing | Sanctions | DPO
  assignedTeam    String   @default("KYC")
  assignedAt      DateTime?
  resolvedAt      DateTime?
  /// approved | edited | rejected — set when reviewer acts
  reviewerDecision String?
  /// Free-text reviewer notes
  reviewerNotes   String?
  /// Original value at the moment of auto-fill (so reviewer can see the diff)
  originalValueJson String?
  createdAt       DateTime @default(now())

  fieldValue      FormFieldValue @relation(fields: [fieldValueId], references: [id], onDelete: Cascade)
  instance        FormInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([fieldValueId])
  @@index([instanceId])
  @@index([status])
  @@index([assignedTeam])
  @@index([reviewerId])
}
