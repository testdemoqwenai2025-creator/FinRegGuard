// ─────────────────────────────────────────────────────────────
// AI INTELLIGENCE LAYER (Pillar 1) — Vector Store + RAG
// ─────────────────────────────────────────────────────────────
// Stores chunked regulatory/policy text + sparse TF-IDF vectors
// as JSON (SQLite has no native vector type). Cosine similarity
// is computed in JS at query time — fine for ~10k chunks.
// Migration path to pgvector / Qdrant is provider-pluggable.

/// A chunk of text from a regulation, policy, risk item, or external source
/// that has been indexed into the vector store for RAG retrieval.
model KnowledgeChunk {
  id            String   @id @default(cuid())
  sourceType    String   // regulation | policy | risk | audit | external | guidance
  sourceId      String   // ID of the originating record (e.g. Regulation.id)
  title         String   // Display title (e.g. "EU AI Act — Art. 6(2) High-Risk")
  content       String   // The chunk text (typically 200-500 chars)
  jurisdiction  String?  // e.g. "EU", "US", "UK", "Global"
  category      String?  // e.g. "ai-governance", "aml", "privacy"
  /// Sparse TF-IDF vector stored as JSON: { "term1": weight1, "term2": weight2, ... }
  /// Computed by the active EmbeddingProvider. For sparse vectors, only non-zero
  /// terms are stored. For dense vectors (future neural embeddings), the full
  /// array is stored and `vectorType` is set to "dense".
  vector        String   // JSON-serialised sparse vector map
  vectorType    String   @default("sparse-tfidf")  // sparse-tfidf | dense-minilm | dense-openai
  /// L2 norm of the vector — precomputed for fast cosine similarity
  norm          Float    @default(0)
  /// Number of tokens in the chunk (for BM25 length normalisation if needed)
  tokenCount    Int      @default(0)
  /// Free-form metadata blob (e.g. article number, effective date, source URL)
  metadata      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sourceType])
  @@index([sourceId])
  @@index([jurisdiction])
  @@index([category])
}

/// Corpus-level statistics for TF-IDF computation.
/// Singleton row (id = "corpus") — updated whenever chunks are upserted.
model CorpusStats {
  id            String   @id @default("corpus")
  /// Total number of indexed chunks (N in IDF formula)
  documentCount Int      @default(0)
  /// Document frequency per term: { "term": doc_count, ... }
  /// Used to compute IDF = log(N / (1 + df))
  docFrequencies String  @default("{}")  // JSON map
  /// Average chunk length in tokens (for BM25 normalisation)
  avgDocLength  Float    @default(0)
  updatedAt     DateTime @updatedAt
}

/// Conversation sessions for the AI Copilot — supports multi-turn context
/// with retrieval history. Each session tracks the messages + the chunks
/// that were retrieved for each assistant turn (for source citations).
model ChatSession {
  id        String   @id @default(cuid())
  title     String?  // Optional human-readable title (auto-derived from first message)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  ChatMessageV2[]
}

/// V2 chat messages — linked to a session, with retrieval provenance.
/// Replaces the flat ChatMessage model for new conversations.
model ChatMessageV2 {
  id         String   @id @default(cuid())
  sessionId  String
  role       String   // user | assistant | system
  content    String
  /// JSON array of KnowledgeChunk IDs retrieved for this turn
  /// (only populated for assistant messages)
  sourceChunkIds String?
  /// Latency in ms for the LLM call (assistant messages only)
  latencyMs  Int?
  createdAt  DateTime @default(now())

  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([role])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// PLUGIN REGISTRY — DeepSeek-style enable/disable system for
// regulatory forms, labels, features, and document templates.
// Plugins can be loaded from web sources and auto-filled with
// templates from authoritative regulators (SEC, FINRA, ESMA, etc.)
// ─────────────────────────────────────────────────────────────

/// A registry plugin — represents a regulation form, label,
/// feature flag, or document template that can be toggled on/off.
/// When enabled, the plugin's data is exposed to dependent views.
/// When marked isDefault, the plugin is the primary source for
/// its category/jurisdiction pair.
model Plugin {
  id            String   @id @default(cuid())
  /// Stable slug — e.g. "sec-form-adv", "label-high-risk", "feature-sanctions-live"
  slug          String   @unique
  name          String
  description   String
  /// form | label | feature | document
  category      String
  /// US | EU | UK | SG | HK | JP | CA | AU | GLOBAL
  jurisdiction  String
  /// SEC | FINRA | ESMA | FCA | MAS | SFC | FSA | OFAC | INTERNAL
  regulator     String?
  version       String   @default("1.0.0")
  /// Source URL where the canonical template lives (regulator website, GitHub, etc.)
  sourceUrl     String
  /// web | template | api | github | rss
  sourceType    String   @default("web")
  /// JSON schema describing the form/label/feature/document fields
  /// Used by the auto-fill engine to render preview + collect values
  schemaJson    String?
  /// Default field values used to auto-fill on first enable
  defaultFieldsJson String?
  /// Tags for filtering in the Plugin Manager UI
  tagsJson      String   @default("[]")
  enabled       Boolean  @default(false)
  isDefault     Boolean  @default(false)
  /// When was this plugin last refreshed from sourceUrl
  lastRefreshedAt DateTime?
  /// When was this plugin first enabled
  enabledAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  template      PluginTemplate?
  history       PluginToggleHistory[]

  @@index([category])
  @@index([jurisdiction])
  @@index([enabled])
  @@index([isDefault])
}

/// Cached template content fetched from sourceUrl.
/// Avoids re-fetching on every page load; refreshed explicitly
/// via the Plugin Manager UI or via scheduled refresh.
model PluginTemplate {
  id            String   @id @default(cuid())
  pluginId      String   @unique
  /// Raw content fetched from sourceUrl (HTML, JSON, MD, XML, etc.)
  rawContent    String
  /// Content-Type header from the source response
  contentType   String?
  /// SHA-256 hash of rawContent — used to detect drift between
  /// the cached template and the live source
  contentHash   String
  /// HTTP status of the last fetch (200, 404, 403, etc.)
  fetchStatus   Int      @default(200)
  /// Optional error message if the fetch failed
  fetchError    String?
  /// Parsed/normalized fields extracted from rawContent
  /// (e.g., for SEC Form ADV: { firm_name: "", crd_number: "", ... })
  parsedFieldsJson String?
  fetchedAt     DateTime @default(now())

  plugin        Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@index([fetchedAt])
}

/// Audit trail of every enable/disable/set-default action —
/// supports the "machine proposes, human confirms" governance model.
model PluginToggleHistory {
  id            String   @id @default(cuid())
  pluginId      String
  /// enabled | disabled | set_default | unset_default | refreshed | autofilled
  /// Drift scanner also writes: drift_reindex | drift_no_change | drift_failed
  action        String
  /// Who triggered the action (user email, "system", or "auto-refresh")
  actor         String   @default("system")
  /// Optional notes — e.g., "User auto-filled from SEC.gov template"
  notes         String?
  createdAt     DateTime @default(now())
  /// Set when a user dismisses the event from the DriftBell UI.
  /// Null = unacknowledged (still surfaces in the bell badge count).
  acknowledgedAt DateTime?
  /// Who dismissed the event (typically "user"). Null when unacknowledged.
  acknowledgedBy String?

  plugin        Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@index([pluginId])
  @@index([action])
  @@index([createdAt])
  @@index([acknowledgedAt])
}
