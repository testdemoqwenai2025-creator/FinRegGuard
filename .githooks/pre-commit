#!/usr/bin/env bash
# Pre-commit hook: run the plugin manifest audit before allowing a commit.
#
# Catches three classes of drift between plugins/manifest.json and the codebase:
#   - STATUS DRIFT: manifest says "ready" but implementation file is missing
#   - DATA DRIFT: manifest references a staticData JSON file that doesn't exist
#   - DYNAMISM DRIFT: declared dynamicSlots not present as null in static JSON
#
# If any drift is detected, the commit is blocked. Fix the manifest or the code,
# then re-stage and try again.
#
# To bypass temporarily (NOT recommended): git commit --no-verify
#
# This file is tracked at .githooks/pre-commit and is auto-installed when a
# developer runs `bun install` (via the `prepare` script in package.json, which
# runs `git config core.hooksPath .githooks`). See CONTRIBUTING.md.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Only run if the manifest exists (don't block commits that don't touch it)
if [ ! -f "plugins/manifest.json" ]; then
  exit 0
fi

# Only run if bun is available (don't break clones that haven't installed deps yet)
if ! command -v bun >/dev/null 2>&1; then
  echo "⚠  bun not found — skipping plugin audit. Install bun to enable pre-commit drift checks."
  exit 0
fi

echo "→ Running plugin manifest audit (pre-commit)..."

# Capture output for display on failure; suppress on success.
# CRITICAL: do NOT use `|| true` here — it masks the real exit code and
# `$?` then returns 0 regardless of whether the audit passed or failed.
# That bug silently let drift commits through from ef815ee until 2026-08-15.
# Use `set +e` around the command instead, then re-enable.
set +e
OUTPUT=$(bun scripts/audit-plugins.ts 2>&1)
EXIT_CODE=$?
set -e

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "✗ Plugin manifest audit FAILED — commit blocked."
  echo ""
  echo "$OUTPUT" | grep -E "DRIFT|FAIL|with issues|EMPTY|THIN|MISSING" | head -20
  echo ""
  echo "To see the full report, run: bun scripts/audit-plugins.ts"
  echo "To bypass (NOT recommended): git commit --no-verify"
  exit 1
fi

echo "✓ Plugin manifest audit passed."
exit 0
